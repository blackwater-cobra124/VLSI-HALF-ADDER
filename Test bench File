module tb_half_adder;

    reg A, B;
    wire Y, C;

    half_adder uut (
        .A(A),
        .B(B),
        .Y(Y),
        .C(C)
    );

    initial begin
        $monitor("A=%b B=%b Y=%b C=%b",
                  A, B, Y, C);

        A = 0; B = 0;
        #10 A = 0; B = 1;
        #10 A = 1; B = 0;
        #10 A = 1; B = 1;
        #10 $finish;
    end

endmodule
