module half_adder (
    input  A,
    input  B,
    output Y,
    output C
);

    wire A_not;
    wire B_not;
    wire term1;
    wire term2;

    // NOT gates
    not (A_not, A);
    not (B_not, B);

    // AND gates for XOR implementation
    and (term1, A, B_not);
    and (term2, A_not, B);

    // OR gate for Sum
    or  (Y, term1, term2);

    // AND gate for Carry
    and (C, A, B);
